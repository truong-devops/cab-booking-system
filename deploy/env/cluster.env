# Deployment configuration checklist. Copy to a secure path, fill real values,
# then source it before running K3s scripts. Do not commit real secrets.

DOMAIN=your-domain.com

# Public DNS
GITLAB_HOST=gitlab.your-domain.com
HARBOR_HOST=harbor.your-domain.com
SONAR_HOST=sonar.your-domain.com
ARGOCD_HOST=argocd.your-domain.com
GRAFANA_HOST=grafana.your-domain.com
API_STAGING_HOST=api-staging.your-domain.com
API_PRODUCTION_HOST=api.your-domain.com
K3S_API_HOST=k3s-api.your-domain.com

# VPS private network. Prefer provider private network; otherwise use WireGuard/Tailscale IPs.
ADMIN_PUBLIC_IP=CHANGE_ME_ADMIN_PUBLIC_IP
PRIVATE_CIDR=10.0.0.0/24
K3S_TOKEN=CHANGE_ME_LONG_RANDOM_K3S_TOKEN
K3S_SERVER_1_PRIVATE_IP=10.0.0.2
K3S_SERVER_2_PRIVATE_IP=10.0.0.3
K3S_SERVER_3_PRIVATE_IP=10.0.0.4
TOOLING_PRIVATE_IP=10.0.0.5

# Harbor robot account for K3s pull-only access.
HARBOR_PULL_REGISTRY=harbor.your-domain.com
HARBOR_PULL_USERNAME=robot$cab-k3s
HARBOR_PULL_PASSWORD=CHANGE_ME_HARBOR_ROBOT_PULL_TOKEN
