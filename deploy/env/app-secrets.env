# App secret checklist for Kubernetes. Copy to a secure path and fill real
# values before creating Secrets. Do not commit real secrets.

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_KEY

POSTGRES_USER=cab_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=cab_booking

AUTH_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/auth-service_db
USER_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/user-service_db
DRIVER_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/driver-service_db
BOOKING_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/booking-service_db
PAYMENT_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/payment-service_db
REVIEW_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/review-service_db
PLACES_DATABASE_URL=postgres://cab_prod:CHANGE_ME_URL_ENCODED_PASSWORD@postgres.data-prod.svc.cluster.local:5432/places-service_db

REDIS_URL=redis://:CHANGE_ME_URL_ENCODED_REDIS_PASSWORD@redis-master.data-prod.svc.cluster.local:6379
RIDE_MONGODB_URI=mongodb://cab_app:CHANGE_ME_URL_ENCODED_MONGO_PASSWORD@mongodb.data-prod.svc.cluster.local:27017/ride_service?authSource=ride_service
NOTIFICATION_MONGODB_URI=mongodb://cab_app:CHANGE_ME_URL_ENCODED_MONGO_PASSWORD@mongodb.data-prod.svc.cluster.local:27017/notification_service?authSource=notification_service

BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_BCRYPT_ROUNDS=10

VIETQR_BANK_BIN=CHANGE_ME_BANK_BIN
VIETQR_ACCOUNT_NUMBER=CHANGE_ME_ACCOUNT_NUMBER
VIETQR_ACCOUNT_NAME=CHANGE_ME_ACCOUNT_NAME
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

PAYOS_CLIENT_ID=CHANGE_ME_PAYOS_CLIENT_ID
PAYOS_API_KEY=CHANGE_ME_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=CHANGE_ME_PAYOS_CHECKSUM_KEY
PAYOS_RETURN_URL=https://admin.your-domain.com/admin/payments?payos=success
PAYOS_CANCEL_URL=https://admin.your-domain.com/admin/payments?payos=cancel

KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
