# Required variables for infra/docker-compose.pro.yml.
# Use this as a checklist for staging/production secret management.
# Do not store real production values in the repository.

JWT_SECRET=replace-with-long-random-secret
INTERNAL_API_KEY=replace-with-long-random-internal-key

POSTGRES_USER=cab_prod
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=cab_booking

REDIS_PASSWORD=replace-with-strong-redis-password
# Full client URI must use a URL-encoded Redis password when it contains reserved URI characters.
REDIS_URL=redis://:replace-with-url-encoded-redis-password@redis:6379

MONGO_ROOT_USERNAME=mongo_root
MONGO_ROOT_PASSWORD=replace-with-strong-mongo-root-password
MONGO_APP_USERNAME=cab_app
MONGO_APP_PASSWORD=replace-with-strong-mongo-app-password
# Full client URIs must use a URL-encoded Mongo app password when it contains reserved URI characters.
RIDE_MONGODB_URI=mongodb://cab_app:replace-with-url-encoded-mongo-app-password@mongo:27017/ride_service?authSource=ride_service
NOTIFICATION_MONGODB_URI=mongodb://cab_app:replace-with-url-encoded-mongo-app-password@mongo:27017/notification_service?authSource=notification_service

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-initial-admin-password
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_BCRYPT_ROUNDS=10

VIETQR_BANK_BIN=replace-with-bank-bin
VIETQR_ACCOUNT_NUMBER=replace-with-account-number
VIETQR_ACCOUNT_NAME=replace-with-account-name

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_RETURN_URL=https://admin.example.com/admin/payments?payos=success
PAYOS_CANCEL_URL=https://admin.example.com/admin/payments?payos=cancel

# Needed only when the ops profile enables pgAdmin.
PGADMIN_DEFAULT_EMAIL=ops@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-strong-pgadmin-password

# Public self-registration should stay limited to non-privileged roles.
AUTH_PUBLIC_REGISTER_ROLES=user,driver

# Keep false when TLS terminates at ingress/load balancer.
GATEWAY_HTTPS_ENABLED=false

# Production compose disables OTel by default unless a collector is deployed.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# The bundled single-broker Kafka is production-shaped for local/staging only.
# For managed Kafka, override KAFKA_BROKERS and set SSL/SASL values as needed.
KAFKA_BROKERS=kafka:9092
KAFKA_BOOTSTRAP_SERVER=kafka:9092
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
KAFKA_TOPIC_RF=1
KAFKA_TOPIC_MIN_ISR=1
KAFKA_TOPIC_DEFAULT_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_TOPIC_SEGMENT_MS=3600000
KAFKA_DLQ_TOPIC_RETENTION_MS=1209600000
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
