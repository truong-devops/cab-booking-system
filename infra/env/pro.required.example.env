# Required variables for infra/docker-compose.pro.yml.
# Use this as a checklist for staging/production secret management.
# Do not store real production values in the repository.

JWT_SECRET=replace-with-long-random-secret
INTERNAL_API_KEY=replace-with-long-random-internal-key

POSTGRES_USER=cab_prod
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=cab_booking

# Use URL-safe values or URL-encode them if they are embedded in REDIS_URL/MONGODB_URI.
REDIS_PASSWORD=replace-with-strong-redis-password

MONGO_ROOT_USERNAME=mongo_root
MONGO_ROOT_PASSWORD=replace-with-strong-mongo-root-password
MONGO_APP_USERNAME=cab_app
MONGO_APP_PASSWORD=replace-with-strong-mongo-app-password

VIETQR_BANK_BIN=replace-with-bank-bin
VIETQR_ACCOUNT_NUMBER=replace-with-account-number
VIETQR_ACCOUNT_NAME=replace-with-account-name

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_RETURN_URL=https://admin.example.com/admin/payments?payos=success
PAYOS_CANCEL_URL=https://admin.example.com/admin/payments?payos=cancel

# Needed only when the ops profile enables pgAdmin.
PGADMIN_DEFAULT_EMAIL=ops@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-strong-pgadmin-password

# Public self-registration should stay limited to non-privileged roles.
AUTH_PUBLIC_REGISTER_ROLES=user,driver

# Keep false when TLS terminates at ingress/load balancer.
GATEWAY_HTTPS_ENABLED=false
